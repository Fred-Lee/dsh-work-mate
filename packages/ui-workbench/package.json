{
  "name": "@helmsman/ui-workbench",
  "version": "0.1.0",
  "description": "Helmsman Workbench front-end — DSH 界面内 4 面板(研究/PRD/执行/知识)统一外壳 + 生成/归档/图谱 REST",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs && node ../../scripts/build-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@helmsman/knowledge-tolaria": "workspace:*",
    "@helmsman/ui-dashboard": "workspace:*",
    "@helmsman/ui-diff": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Helmsman Team",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "workbench",
    "panel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/helmsman/helmsman.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
