{
  "name": "@helmsman/adapter-oh-my-pi",
  "version": "0.1.0",
  "description": "Helmsman agent adapter — oh-my-pi CLI",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {},
  "license": "MIT",
  "author": "Helmsman Team",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "agent",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/helmsman/helmsman.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
