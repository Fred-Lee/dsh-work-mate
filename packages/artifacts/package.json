{
  "name": "@helmsman/artifacts",
  "version": "0.1.0",
  "description": "Helmsman artifact registry — content-addressed delivery store under ~/.helmsman/artifacts (sha256 blobs + atomic manifest.json), plus CJK-safe download headers.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs . && tsc -p tsconfig.decls.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {},
  "license": "MIT",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "artifact",
    "delivery"
  ],
  "publishConfig": {
    "access": "public"
  }
}
