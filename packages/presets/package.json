{
  "name": "@helmsman/presets",
  "version": "0.1.0",
  "description": "Helmsman agent presets (research/prd/decompose/require-analyze) + helmsman_* generation tools. Generation runs through an injected helmsman.generator service (DSH session start is behind that seam).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs . && tsc -p tsconfig.decls.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "*",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {},
  "license": "MIT",
  "author": "Helmsman Team",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "presets",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/helmsman/helmsman.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
