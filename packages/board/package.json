{
  "name": "@helmsman/board",
  "version": "0.1.0",
  "description": "Helmsman board — the WorkItem aggregation root: 4-stage lifecycle with versioned migration events, reference-only association set, DoR/DoD gate data + validation, conflict-domain WIP, conversation summaries, durable state under ~/.helmsman/board (atomic items.json + events.jsonl).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs . && tsc -p tsconfig.decls.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {},
  "license": "MIT",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "board",
    "workitem",
    "kanban",
    "lifecycle"
  ],
  "publishConfig": {
    "access": "public"
  }
}
