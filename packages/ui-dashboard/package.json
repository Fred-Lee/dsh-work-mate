{
  "name": "@helmsman/ui-dashboard",
  "version": "0.1.0",
  "description": "Helmsman dashboard Web UI — agent fleet command center (PRD §4 UI spec compliant)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client/embed": {
      "types": "./dist/client/embed.d.ts",
      "default": "./dist/client/embed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs && node ../../scripts/build-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@helmsman/memory-topology": "workspace:*",
    "@helmsman/orchestrator": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@helmsman/artifacts": "workspace:*"
  },
  "license": "MIT",
  "author": "Helmsman Team",
  "keywords": [
    "helmsman",
    "dsh",
    "deepseek-harness",
    "agent",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/helmsman/helmsman.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
