{
  "name": "workmate4dsh",
  "version": "0.1.0",
  "description": "WorkMate — a DSH plugin bundle built around the change-proposal entity: proposal management, GitNexus knowledge bridging, Super-agent task handoff and an OpenSpec archival loop.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "scripts/gitnexus-sse-proxy.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.decls.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.packages.json --noEmit",
    "test": "vitest run",
    "test:toolchain": "node --test scripts/*.test.mjs",
    "verify:contract": "node scripts/check-contract.mjs",
    "verify:toolchain": "node scripts/check-toolchain.mjs --structural",
    "prepack": "pnpm run build",
    "verify:host-compat": "node scripts/check-host-compat.mjs",
    "verify": "pnpm verify:contract && pnpm verify:toolchain && pnpm verify:host-compat && pnpm verify:client && pnpm verify:source && pnpm verify:test",
    "verify:client": "node scripts/check-client-factory.mjs",
    "verify:test": "node scripts/check-test-integrity.mjs",
    "verify:built": "node scripts/check-built-tools.mjs",
    "verify:source": "node scripts/check-source-bundle.mjs",
    "verify:drill": "node --experimental-transform-types scripts/verify-superagent-offline.mjs --superagent ${SUPERAGENT_ROOT:-../dsh-superagent-prototype}"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "workmate",
    "dsh",
    "deepseek-harness",
    "plugin",
    "change-proposal",
    "openspec",
    "gitnexus"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "packageManager": "pnpm@10.33.2"
}
